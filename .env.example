NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_PATH=
DATABASE_URL=postgres://intake:intake-dev-only@db:5432/intake
POSTGRES_PASSWORD=intake-dev-only

# Create a 3CX Service Principal with Call Control access. Keep the secret outside source control.
PBX_BASE=https://pbx.example.invalid
PBX_APP_ID=service-intake
PBX_APP_SECRET=replace-me
SERVICE_QUEUE_EXTENSION=
SERVICE_DISPATCH_ENABLED=false

# OpenAI Realtime voice interview (keep this key private)
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-realtime-2.1
OPENAI_VOICE=alloy
COMPANY_NAME=servisní podpory
AGENT_PROFILE=service-intake
AGENT_NAME=Asistentka

# Test-only outbound controls. The only permitted destination is SERVICE_QUEUE_EXTENSION.
TEST_OUTBOUND_ENABLED=false
TEST_AUDIO_TONE_HZ=700
TEST_AUDIO_TONE_MS=500

# Dashboard/API login. Use a long random password; do not reuse a 3CX or OpenAI secret.
DASHBOARD_USERNAME=client
DASHBOARD_PASSWORD=replace-with-a-random-password-at-least-24-characters
# Initial administrator, created once at first application startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-different-random-password-at-least-24-characters
PUBLIC_DOMAIN=dashboard.example.cz
THREEX_REPORT_CALL_TOKEN=generate-a-random-token-at-least-32-characters

LOG_LEVEL=info
